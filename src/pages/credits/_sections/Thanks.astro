---
import arena from "../_images/arena.svg";
import astro from "../_images/astro.svg";
import biome from "../_images/biome.svg";
import codepen from "../_images/codepen.svg";
import figma from "../_images/figma.svg";
import frontendHorse from "../_images/frontend-horse.svg";
import sfpc from "../_images/sfpc.svg";
import three from "../_images/three.svg";

interface SvgMetadata {
  src: string;
  width: number;
  height: number;
}

function sizedTo(image: SvgMetadata, height: number) {
  return { width: Math.round((height / image.height) * image.width), height };
}
---

<section>
  <h2>Built With</h2>
  <div class="thanks">
    <a href="https://astro.build/">
      <img src={astro.src} alt="Astro" {...sizedTo(astro, 64)} />
    </a>
    <a href="https://biomejs.dev/">
      <img src={biome.src} alt="Biome" {...sizedTo(biome, 48)} />
    </a>
    <a href="https://codepen.io/">
      <img src={codepen.src} alt="Codepen" {...sizedTo(codepen, 44)} />
    </a>
    <a href="https://www.figma.com/">
      <img src={figma.src} alt="Figma" {...sizedTo(figma, 48)} />
    </a>
    <a href="https://threejs.org/">
      <img src={three.src} alt="Three.js" {...sizedTo(three, 68)} />
    </a>
    <a href="https://are.na/">
      <img src={arena.src} alt="Are.na" {...sizedTo(arena, 48)} />
    </a>
    <a href="https://frontend.horse/">
      <img
        src={frontendHorse.src}
        alt="Frontend Horse"
        {...sizedTo(frontendHorse, 80)}
      />
    </a>
    <a href="https://sfpc.study/">
      <img src={sfpc.src} alt="SFPC" {...sizedTo(sfpc, 68)} />
    </a>
  </div>
</section>

<style>
  .thanks {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    row-gap: 3rem;
    column-gap: 2rem;
    align-items: center;
    justify-items: center;

    @media (width < 1200px) {
      max-width: 600px;
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
