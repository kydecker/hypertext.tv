---
import Rainbow from "@components/Rainbow.astro";
import Television from "@components/Television.astro";
import Layout from "@layouts/Layout.astro";
import { GET } from "../api/contributors.json";
import Featuring from "./_sections/Featuring.astro";
import Fonts from "./_sections/Fonts.astro";
import Intro from "./_sections/Intro.astro";
import Thanks from "./_sections/Thanks.astro";

const response = await GET(Astro);
const contributors: string[] = await response.json();
---

<Layout title="Credits">
  <Television
    activeProgram={{
      program: { title: "Site Credits" },
    }}
    channelId="999"
    channelName="Credits"
  >
    <div id="credits">
      <div class="credits-content">
        <Intro />
        <Featuring contributors={contributors} />
        <Fonts />
        <Thanks />
      </div>
    </div>
    <Rainbow />
  </Television>
</Layout>

<style is:global>
  #credits {
    width: 100%;
    height: 100%;
    color: #fff;
    padding-inline: 2rem;
    position: relative;
    font-size: clamp(18px, 3vw, 24px);
    user-select: none;
    overflow-y: auto;
    scrollbar-width: none;
    z-index: 1;

    a {
      color: #fff;
    }

    section {
      width: 100%;
      margin: 0 auto;
    }

    img {
      height: auto;
    }

    h1 {
      margin-bottom: 4rem;
    }

    h2 {
      margin-block: 8rem 3rem;
    }
  }

  .credits-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 auto;
    text-align: center;
    padding-block: 4rem;
  }
</style>

<script>
  import { infiniteScrollLoop } from "@utils/infiniteScroll";

  let cleanupInfiniteScroll: (() => void) | null = null;

  document.addEventListener("astro:page-load", () => {
    const wrapper = document.getElementById("credits");
    const content = wrapper?.querySelector(".credits-content") as HTMLElement;

    if (wrapper && content) {
      cleanupInfiniteScroll = infiniteScrollLoop(wrapper, content);
    }
  });

  document.addEventListener("astro:before-swap", () => {
    if (cleanupInfiniteScroll) {
      cleanupInfiniteScroll();
      cleanupInfiniteScroll = null;
    }
  });
</script>
