<div id="rainbow"></div>

<style>
  #rainbow {
    position: absolute;
    inset: 0;
    z-index: 0;

    :global(canvas) {
      animation: fade-in 0.6s ease-out;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  import { whenIdle } from "../utils/whenIdle";

  let cleanupScene: (() => void) | null = null;

  document.addEventListener("astro:page-load", () => {
    const canvas = document.getElementById("rainbow");
    if (!canvas) return;
    cleanupScene = whenIdle(async () => {
      const { mountRainbow } = await import("../scenes/rainbow");
      return mountRainbow(canvas);
    });
  });

  document.addEventListener("astro:before-swap", () => {
    cleanupScene?.();
    cleanupScene = null;
  });
</script>
