{
  "name": "hypertext-tv",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.14.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro build",
    "preview": "wrangler types && astro preview",
    "astro": "astro",
    "format": "biome format",
    "format:fix": "biome format --write .",
    "lint": "biome lint",
    "lint:fix": "biome lint --write .",
    "check": "astro check && biome check",
    "check:fix": "astro check && biome check --write ."
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged"
  },
  "nano-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "howler": "^2.2.4",
    "three": "^0.174.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^25.9.9",
    "@types/three": "^0.174.0",
    "browserslist": "^4.29.3",
    "lightningcss": "^1.33.0",
    "nano-staged": "^1.0.2",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "wrangler": "^4.151.0"
  }
}
